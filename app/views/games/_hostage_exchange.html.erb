<%
usurp_message = game.usurp_message

usurp_message_1 = usurp_message&.split('!')[0] if usurp_message&.present?
usurp_message_2 = usurp_message&.split('!')[1] if usurp_message&.present?

room_players = game.players.where(room: player.room)
current_hostages = room_players.where(is_hostage: true)
required_hostages = game.hostages_for_current_round

is_leader = player.is_leader
is_leader_alone = room_players.count <= 1
leader_already_confirmed = is_leader_alone || (current_hostages.count == required_hostages && required_hostages > 0)
%>

<div class="flex-1 flex flex-col px-4 py-6">
  <div class="text-center mb-6">
    <div class="inline-flex items-center gap-2 bg-purple-500/20 rounded-full px-4 py-2 mb-3">
      <span class="text-2xl">🔄</span>
      <span class="font-display text-lg font-bold text-purple-400">Troca de Reféns</span>
    </div>
    <p class="text-slate-400">Rodada <%= game.current_round %> - Trocar <%= game.hostages_for_current_round %> refém(s)</p>
  </div>

  <div id="game_notifications">
    <% if game.usurp_message&.present? %>
      <div class="mb-6 mx-auto max-w-sm animate-[fadeIn_0.5s_ease-out]">
        <div class="bg-purple-500/20 border border-purple-500/30 rounded-xl p-4 mb-4 text-center">
          <div class="text-3xl mb-2">🗡️👑</div>
          <p class="text-white font-bold text-base leading-snug">
            <%= usurp_message_1 %>!
          </p>
          <p class="text-white font-semibold text-sm leading-snug">
            <%= usurp_message_2 %>
          </p>
        </div>
      </div>
    <% end %>
  </div>
  <div class="grid grid-cols-2 gap-4 mb-6">
    <div class="bg-slate-800/30 rounded-xl p-3 text-center">
      <p class="text-slate-400 text-sm mb-1">Líder Sala 1</p>
      <% if game.room_1_leader %>
        <p class="text-white font-semibold">👑 <%= game.room_1_leader.name %></p>
      <% end %>
    </div>
    <div class="bg-slate-800/30 rounded-xl p-3 text-center">
      <p class="text-slate-400 text-sm mb-1">Líder Sala 2</p>
      <% if game.room_2_leader %>
        <p class="text-white font-semibold">👑 <%= game.room_2_leader.name %></p>
      <% end %>
    </div>
  </div>

  <% if is_leader %>
    <div class="flex-1">
      <% if leader_already_confirmed %>
        
        <div class="bg-green-500/10 border border-green-500/30 rounded-xl p-4 mb-4">
          <p class="text-green-400 font-semibold text-center">
            ✅ Seleção confirmada! Aguardando o outro time...
          </p>
        </div>

        <h3 class="text-sm font-semibold text-slate-400 mb-3 uppercase">Status da Seleção</h3>
        <div class="space-y-2 mb-4">
          <% current_hostages.each do |p| %>
            <div class="flex items-center gap-3 bg-slate-800/30 rounded-xl px-4 py-3 border-2 <%= p.role&.include?('gargoyle') ? 'border-red-500/50' : 'border-purple-500' %>">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-slate-600 to-slate-700 flex items-center justify-center text-lg">
                <%= p.name.chars.first.upcase %>
              </div>
              <div class="flex-1">
                <p class="font-semibold text-white"><%= p.name %></p>
              </div>
              <span class="text-purple-400 text-sm font-bold">➡️ Vai trocar</span>
            </div>
          <% end %>
        </div>

        <div class="bg-slate-800/30 rounded-xl p-4 mb-20">
          <div class="animate-pulse text-2xl text-center mb-2">⏳</div>
          <p class="text-slate-400 text-center text-sm">
            A troca será executada automaticamente quando o outro líder confirmar.
          </p>
        </div>

        <div data-controller="refresh" data-refresh-interval-value="2000" data-refresh-url-value="<%= game_path(game) %>"></div>

      <% else %>
        
        <% if room_players.count <= 1 %>
          <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-4 mb-4">
            <p class="text-amber-400 font-semibold text-center">
              👑 Você está sozinho na sala!
            </p>
            <p class="text-slate-400 text-xs text-center mt-1">
              Você não enviará reféns, apenas receberá quem vier da outra sala.
            </p>
          </div>
          
          <%= form_with url: select_hostages_game_path(game), method: :post do %>
            <input type="hidden" name="hostage_ids[]" value="">
            <button type="submit" class="w-full py-4 bg-amber-500 hover:bg-amber-400 text-white font-bold text-lg rounded-xl transition-all shadow-lg transform hover:scale-105">
              <span>Confirmar e Aguardar</span>
            </button>
          <% end %>

        <% else %>
          <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-4 mb-4">
            <p class="text-amber-400 font-semibold text-center">
              👑 Você é o líder! Escolha <%= required_hostages %> refém(s) para enviar à outra sala.
            </p>
          </div>

          <%= form_with url: select_hostages_game_path(game), method: :post, data: { controller: "hostage-selection" } do |f| %>
            <div class="space-y-2 mb-4">
              <% room_players.where.not(id: player.id).each do |p| %>
                <label class="flex items-center gap-3 bg-slate-800/30 hover:bg-slate-700/50 rounded-xl px-4 py-3 cursor-pointer transition-all
                  <%= p.is_hostage ? 'border-2 border-purple-500' : 'border border-transparent' %>">
                  
                  <input
                    type="checkbox"
                    name="hostage_ids[]"
                    value="<%= p.id %>"
                    <%= 'checked' if p.is_hostage %>
                    class="w-5 h-5 rounded border-slate-500 bg-slate-700 text-purple-500 focus:ring-purple-500"
                    data-hostage-selection-target="checkbox"
                    data-action="change->hostage-selection#update"
                  >
                  
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-slate-600 to-slate-700 flex items-center justify-center text-lg">
                    <%= p.name.chars.first.upcase %>
                  </div>
                  <div class="flex-1">
                    <p class="font-semibold text-white"><%= p.name %></p>
                  </div>
                  <% if p.is_hostage %>
                    <span class="text-purple-400 text-sm font-semibold">Refém</span>
                  <% end %>
                </label>
              <% end %>
            </div>

            <p class="text-center text-slate-400 mb-4">
              Selecionados: <span class="text-white font-bold" data-hostage-selection-target="count">0</span> / <%= required_hostages %>
            </p>

            <button type="submit" class="w-full py-4 bg-gradient-to-r from-purple-500 to-pink-500 hover:from-purple-400 hover:to-pink-400 text-white font-bold text-lg rounded-xl transition-all shadow-lg transform hover:scale-105 active:scale-95">
              ✓ Confirmar Reféns
            </button>
          <% end %>
        <% end %>
      <% end %>
    </div>

  <% elsif player.role&.include?('gargoyle') %>
    <% pending = game.parsed_gargoyle_pending || {} %>
    <% my_decision = pending[player.id.to_s] %>
    <% was_selected_as_hostage = player.is_hostage? %>
    
    <% if was_selected_as_hostage && my_decision.nil? && !player.ability_used? %>
      <%# GÁRGULA FOI SELECIONADO E PRECISA DECIDIR %>
      <div class="flex-1 flex flex-col items-center justify-center">
        <div class="bg-gradient-to-br from-amber-900/40 to-slate-900/40 border-2 border-amber-500/50 rounded-2xl p-6 text-center max-w-sm mb-6 shadow-[0_0_30px_rgba(245,158,11,0.2)] animate-pulse">
          <div class="text-5xl mb-4">🗿⚡</div>
          
          <h3 class="font-display text-xl font-bold text-white mb-2">Você foi escolhido como refém!</h3>
          <p class="text-slate-300 text-sm mb-4">
            Como <strong>Gárgula</strong>, você pode <strong>recusar</strong> ir para a outra sala. 
            <span class="text-amber-400">Esta habilidade só pode ser usada UMA VEZ no jogo!</span>
          </p>
          
          <div class="space-y-3">
            <%= form_with url: gargoyle_decision_game_path(game), method: :post, class: "inline" do %>
              <input type="hidden" name="decision" value="accept">
              <button type="submit" class="w-full py-3 bg-gradient-to-r from-green-600 to-green-700 hover:from-green-500 hover:to-green-600 text-white font-bold rounded-xl transition-all">
                ✅ Aceitar ir como refém
              </button>
            <% end %>
            
            <%= form_with url: gargoyle_decision_game_path(game), method: :post, class: "inline" do %>
              <input type="hidden" name="decision" value="refuse">
              <button type="submit" class="w-full py-3 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-bold rounded-xl transition-all mt-2">
                🗿 RECUSAR - Usar Habilidade (1x)
              </button>
            <% end %>
          </div>
        </div>
      </div>
      
    <% elsif was_selected_as_hostage && my_decision == 'refused' %>
      <%# GÁRGULA RECUSOU %>
      <div class="flex-1 flex flex-col items-center justify-center">
        <div class="bg-green-500/10 border border-green-500/30 rounded-2xl p-8 text-center max-w-sm">
          <div class="text-6xl mb-4">🗿✅</div>
          <h3 class="font-display text-xl font-bold text-green-400 mb-3">Você ficará na sala!</h3>
          <p class="text-slate-400 mb-4">
            Você usou sua habilidade de Gárgula e não será enviado como refém.
          </p>
          <div class="flex items-center justify-center gap-2 text-slate-500">
            <div class="animate-pulse">⏳</div>
            <span class="text-sm">Aguardando a troca...</span>
          </div>
        </div>
      </div>
      <div data-controller="refresh" data-refresh-interval-value="2000" data-refresh-url-value="<%= game_path(game) %>"></div>
      
    <% elsif was_selected_as_hostage && my_decision == 'accepted' %>
      <%# GÁRGULA ACEITOU IR %>
      <div class="flex-1 flex flex-col items-center justify-center">
        <div class="bg-purple-500/10 border border-purple-500/30 rounded-2xl p-8 text-center max-w-sm">
          <div class="text-6xl mb-4">🗿➡️</div>
          <h3 class="font-display text-xl font-bold text-purple-400 mb-3">Você aceitou ir!</h3>
          <p class="text-slate-400 mb-4">
            Você será enviado para a outra sala como refém.
          </p>
          <div class="flex items-center justify-center gap-2 text-slate-500">
            <div class="animate-pulse">⏳</div>
            <span class="text-sm">Aguardando a troca...</span>
          </div>
        </div>
      </div>
      <div data-controller="refresh" data-refresh-interval-value="2000" data-refresh-url-value="<%= game_path(game) %>"></div>
      
    <% else %>
      <%# GÁRGULA NÃO FOI SELECIONADO OU JÁ USOU HABILIDADE %>
      <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-4 mb-4">
        <p class="text-amber-400 font-semibold text-center">
          🗿 Você é uma Gárgula! 
          <% if player.ability_used? %>
            <span class="text-red-400">(Habilidade já usada)</span>
          <% end %>
        </p>
      </div>
      <div class="flex-1 flex flex-col items-center justify-center">
        <div class="bg-gradient-to-br from-purple-500/10 to-pink-500/10 border border-purple-500/30 rounded-2xl p-8 text-center max-w-sm">
          <div class="text-6xl mb-4">🤝</div>
          <h3 class="font-display text-xl font-bold text-purple-400 mb-3">Negociação em Andamento</h3>
          <p class="text-slate-400 mb-4">
            Os líderes estão negociando a troca de reféns entre as salas.
          </p>
          <div class="flex items-center justify-center gap-2 text-slate-500">
            <div class="animate-pulse">⏳</div>
            <span class="text-sm">Aguarde a conclusão...</span>
          </div>
        </div>

        <div class="mt-6 bg-slate-800/30 rounded-xl p-4 text-center">
          <p class="text-slate-400 text-sm mb-1">Líder da sua sala:</p>
          <% my_leader = room_players.find_by(is_leader: true) %>
          <% if my_leader %>
            <p class="text-amber-400 font-semibold">👑 <%= my_leader.name %></p>
          <% end %>
        </div>
      </div>
      <div data-controller="refresh" data-refresh-interval-value="2000" data-refresh-url-value="<%= game_path(game) %>"></div>
    <% end %>

  <% elsif player.role&.include?('usurper') %>
    <div class="flex-1 flex flex-col items-center justify-center">
      <div class="bg-gradient-to-br from-purple-900/40 to-slate-900/40 border-2 border-purple-500/50 rounded-2xl p-6 text-center max-w-sm mb-6 shadow-[0_0_30px_rgba(168,85,247,0.2)]">
        <div class="text-5xl mb-4">👑🗡️</div>
        
        <h3 class="font-display text-xl font-bold text-white mb-2">Habilidade Especial</h3>
        <p class="text-slate-300 text-sm mb-6">
          Você é a <strong>Usurpadora</strong>. Você pode revelar sua carta agora e tomar a liderança desta sala imediatamente.
        </p>

        <%= form_with url: usurp_leadership_game_path(game), method: :post, data: { turbo: false } do %>
          <button type="submit" 
            class="w-full py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-bold text-lg rounded-xl transition-all shadow-lg transform hover:scale-105 active:scale-95 flex items-center justify-center gap-2"
            data-confirm="Tem certeza? Isso vai revelar sua carta para todos da sala!">
            <span>👑 Roubar Liderança</span>
          </button>
        <% end %>
      </div>

      <div class="bg-slate-800/30 rounded-xl p-4 text-center max-w-sm w-full">
        <p class="text-slate-400 text-sm mb-1">Líder atual da sua sala:</p>
        <% my_leader = room_players.find_by(is_leader: true) %>
        <% if my_leader %>
          <p class="text-amber-400 font-semibold text-lg">👑 <%= my_leader.name %></p>
        <% end %>
        
        <div class="mt-4 flex items-center justify-center gap-2 text-slate-500 text-xs">
          <div class="animate-pulse">⏳</div>
          <span>Aguardando negociação...</span>
        </div>
      </div>
    </div>

  <% else %>
    <div class="flex-1 flex flex-col items-center justify-center">
      <div class="bg-gradient-to-br from-purple-500/10 to-pink-500/10 border border-purple-500/30 rounded-2xl p-8 text-center max-w-sm">
        <div class="text-6xl mb-4">🤝</div>
        <h3 class="font-display text-xl font-bold text-purple-400 mb-3">Negociação em Andamento</h3>
        <p class="text-slate-400 mb-4">
          Os líderes estão negociando a troca de reféns entre as salas.
        </p>
        <div class="flex items-center justify-center gap-2 text-slate-500">
          <div class="animate-pulse">⏳</div>
          <span class="text-sm">Aguarde a conclusão...</span>
        </div>
      </div>

      <div class="mt-6 bg-slate-800/30 rounded-xl p-4 text-center">
        <p class="text-slate-400 text-sm mb-1">Líder da sua sala:</p>
        <% my_leader = room_players.find_by(is_leader: true) %>
        <% if my_leader %>
          <p class="text-amber-400 font-semibold">👑 <%= my_leader.name %></p>
        <% end %>
      </div>
    </div>
  <% end %>

</div>

<% unless is_leader %>
  <div data-controller="refresh" data-refresh-interval-value="2000" data-refresh-url-value="<%= game_path(game) %>"></div>
<% end %>