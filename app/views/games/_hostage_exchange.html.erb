<div class="flex-1 flex flex-col px-4 py-6">
  <!-- Header -->
  <div class="text-center mb-6">
    <div class="inline-flex items-center gap-2 bg-purple-500/20 rounded-full px-4 py-2 mb-3">
      <span class="text-2xl">🔄</span>
      <span class="font-display text-lg font-bold text-purple-400">Troca de Reféns</span>
    </div>
    <p class="text-slate-400">Rodada <%= game.current_round %> - Trocar <%= game.hostages_for_current_round %> refém(s)</p>
  </div>

  <!-- Info dos líderes -->
  <div class="grid grid-cols-2 gap-4 mb-6">
    <div class="bg-slate-800/30 rounded-xl p-3 text-center">
      <p class="text-slate-400 text-sm mb-1">Líder Sala 1</p>
      <% if game.room_1_leader %>
        <p class="text-white font-semibold">👑 <%= game.room_1_leader.name %></p>
      <% end %>
    </div>
    <div class="bg-slate-800/30 rounded-xl p-3 text-center">
      <p class="text-slate-400 text-sm mb-1">Líder Sala 2</p>
      <% if game.room_2_leader %>
        <p class="text-white font-semibold">👑 <%= game.room_2_leader.name %></p>
      <% end %>
    </div>
  </div>

  <!-- Card do papel (mini) -->
  <div class="flex justify-center mb-6">
    <div
      id="player-card-mini"
      class="card-flip w-24 h-32 cursor-pointer"
      onclick="this.classList.toggle('flipped')"
    >
      <div class="card-flip-inner relative w-full h-full">
        <div class="card-front absolute inset-0 bg-gradient-to-br from-slate-700 to-slate-800 rounded-xl border-2 border-slate-600 flex items-center justify-center">
          <span class="text-2xl">🎴</span>
        </div>
        <div class="card-back absolute inset-0 rounded-xl border-2 flex flex-col items-center justify-center
          <%= player.team == 'blue' ? 'bg-gradient-to-br from-blue-900 to-blue-950 border-blue-500' : 'bg-gradient-to-br from-red-900 to-red-950 border-red-500' %>">
          <span class="text-3xl"><%= player.role_icon %></span>
          <span class="text-xs text-white mt-1"><%= player.role_name %></span>
        </div>
      </div>
    </div>
  </div>

  <% is_leader = player.is_leader %>
  <% room_players = game.players.where(room: player.room) %>
  <% current_hostages = room_players.where(is_hostage: true) %>
  <% required_hostages = game.hostages_for_current_round %>

  <% leader_already_confirmed = current_hostages.count == required_hostages %>

  <% if is_leader %>
    <!-- Interface do líder para selecionar reféns -->
    <div class="flex-1">
      <% if leader_already_confirmed %>
        <!-- Líder já confirmou - mostra status de aguardando -->
        <div class="bg-green-500/10 border border-green-500/30 rounded-xl p-4 mb-4">
          <p class="text-green-400 font-semibold text-center">
            ✅ Reféns confirmados! Aguardando o outro time escolher...
          </p>
        </div>

        <h3 class="text-sm font-semibold text-slate-400 mb-3 uppercase">Reféns selecionados</h3>
        <div class="space-y-2 mb-4">
          <% current_hostages.each do |p| %>
            <div class="flex items-center gap-3 bg-slate-800/30 rounded-xl px-4 py-3 border-2 border-purple-500">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-slate-600 to-slate-700 flex items-center justify-center text-lg">
                <%= p.name.chars.first.upcase %>
              </div>
              <div class="flex-1">
                <p class="font-semibold text-white"><%= p.name %></p>
              </div>
              <span class="text-purple-400 text-sm font-semibold">Refém</span>
            </div>
          <% end %>
        </div>

        <div class="bg-slate-800/30 rounded-xl p-4 mb-20">
          <div class="animate-pulse text-2xl text-center mb-2">⏳</div>
          <p class="text-slate-400 text-center text-sm">
            A troca será executada automaticamente quando o outro líder confirmar.
          </p>
        </div>

        <!-- Auto-refresh para o líder que já confirmou -->
        <div data-controller="refresh" data-refresh-interval-value="2000" data-refresh-url-value="<%= game_path(game) %>"></div>

      <% else %>
        <!-- Líder ainda não confirmou - mostra formulário -->
        <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-4 mb-4">
          <p class="text-amber-400 font-semibold text-center">
            👑 Você é o líder! Escolha <%= required_hostages %> refém(s) para enviar à outra sala.
          </p>
        </div>

        <%= form_with url: select_hostages_game_path(game), method: :post, id: "hostage-form" do %>
          <div class="space-y-2 mb-4">
            <% room_players.where.not(id: player.id).each do |p| %>
              <label class="flex items-center gap-3 bg-slate-800/30 hover:bg-slate-700/50 rounded-xl px-4 py-3 cursor-pointer transition-all
                <%= p.is_hostage ? 'border-2 border-purple-500' : 'border border-transparent' %>">
                <input
                  type="checkbox"
                  name="hostage_ids[]"
                  value="<%= p.id %>"
                  <%= 'checked' if p.is_hostage %>
                  class="w-5 h-5 rounded border-slate-500 bg-slate-700 text-purple-500 focus:ring-purple-500"
                  onchange="updateHostageCount()"
                >
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-slate-600 to-slate-700 flex items-center justify-center text-lg">
                  <%= p.name.chars.first.upcase %>
                </div>
                <div class="flex-1">
                  <p class="font-semibold text-white"><%= p.name %></p>
                </div>
                <% if p.is_hostage %>
                  <span class="text-purple-400 text-sm font-semibold">Refém</span>
                <% end %>
              </label>
            <% end %>
          </div>

          <p id="hostage-count" class="text-center text-slate-400 mb-4">
            Selecionados: <span class="text-white font-bold">0</span> / <%= required_hostages %>
          </p>

          <button type="submit" class="w-full py-4 bg-gradient-to-r from-purple-500 to-pink-500 hover:from-purple-400 hover:to-pink-400 text-white font-bold text-lg rounded-xl transition-all">
            ✓ Confirmar Reféns
          </button>
        <% end %>

        <script>
          function updateHostageCount() {
            const checkboxes = document.querySelectorAll('input[name="hostage_ids[]"]:checked');
            document.querySelector('#hostage-count span').textContent = checkboxes.length;
          }
          updateHostageCount();
        </script>
      <% end %>
    </div>

  <% else %>
    <!-- Vista de não-líder: apenas card de aguardando -->
    <div class="flex-1 flex flex-col items-center justify-center">
      <div class="bg-gradient-to-br from-purple-500/10 to-pink-500/10 border border-purple-500/30 rounded-2xl p-8 text-center max-w-sm">
        <div class="text-6xl mb-4">🤝</div>
        <h3 class="font-display text-xl font-bold text-purple-400 mb-3">Negociação em Andamento</h3>
        <p class="text-slate-400 mb-4">
          Os líderes estão negociando a troca de reféns entre as salas.
        </p>
        <div class="flex items-center justify-center gap-2 text-slate-500">
          <div class="animate-pulse">⏳</div>
          <span class="text-sm">Aguarde a conclusão...</span>
        </div>
      </div>

      <!-- Info do líder da sua sala -->
      <div class="mt-6 bg-slate-800/30 rounded-xl p-4 text-center">
        <p class="text-slate-400 text-sm mb-1">Líder da sua sala:</p>
        <% my_leader = room_players.find_by(is_leader: true) %>
        <% if my_leader %>
          <p class="text-amber-400 font-semibold">👑 <%= my_leader.name %></p>
        <% end %>
      </div>
    </div>
  <% end %>

</div>

<!-- Auto-refresh para não-líderes (líder que já confirmou tem refresh próprio acima) -->
<% unless is_leader %>
  <div data-controller="refresh" data-refresh-interval-value="2000" data-refresh-url-value="<%= game_path(game) %>"></div>
<% end %>

