<div class="flex-1 flex flex-col px-4 py-6">
  <!-- Notificações de Card Share -->
  <div id="card_share_notifications"></div>

  <!-- Header com info da rodada -->
  <div class="text-center mb-6">
    <div class="inline-flex items-center gap-2 bg-slate-800/50 rounded-full px-4 py-2 mb-3">
      <span class="text-slate-400 text-sm">Rodada</span>
      <span class="font-display text-xl font-bold text-amber-400"><%= game.current_round %>/<%= game.total_rounds %></span>
    </div>

    <!-- Cronômetro -->
    <div
      data-controller="timer"
      data-timer-seconds-value="<%= game.time_remaining %>"
      data-timer-game-id-value="<%= game.id %>"
      data-timer-expired-url-value="<%= timer_expired_game_path(game) %>"
      class="mb-4"
    >
      <div class="font-display text-5xl font-black text-white" data-timer-target="display">
        <%= "%02d:%02d" % [game.time_remaining / 60, game.time_remaining % 60] %>
      </div>
      <p class="text-slate-400 text-sm mt-1">Tempo restante para conversar</p>
    </div>

    <!-- Sala atual -->
    <div class="inline-flex items-center gap-2 bg-slate-700/50 rounded-xl px-4 py-2">
      <span class="text-2xl">🚪</span>
      <span class="font-semibold text-white">Sala <%= player.room %></span>
      <span class="text-slate-400 text-sm">(<%= game.players.where(room: player.room).count %> jogadores)</span>
    </div>

    <% if player.is_infected? %>
      <div class="mt-2 inline-flex items-center gap-2 bg-green-900/50 border border-green-500/50 rounded-xl px-4 py-2">
        <span class="text-xl">🧟</span>
        <span class="text-green-400 text-sm font-semibold">Você foi infectado!</span>
      </div>
    <% end %>
  </div>

  <!-- Card do papel -->
  <div class="flex-1 flex flex-col items-center justify-center mb-6">
    <div
      id="player-card"
      class="card-flip w-72 h-96 cursor-pointer"
      onclick="this.classList.toggle('flipped')"
    >
      <div class="card-flip-inner relative w-full h-full">
        <!-- Frente (escondido) -->
        <div class="card-front absolute inset-0 bg-gradient-to-br from-slate-700 to-slate-800 rounded-3xl border-4 border-slate-600 flex flex-col items-center justify-center shadow-2xl">
          <div class="text-6xl mb-4">🎴</div>
          <p class="text-slate-400 font-semibold">Toque para ver seu papel</p>
          <p class="text-slate-500 text-sm mt-2">Cuidado com quem está olhando!</p>
        </div>

        <!-- Verso (revelado) -->
        <div class="card-back absolute inset-0 rounded-3xl border-4 flex flex-col items-center justify-center p-6 shadow-2xl <%= player.card_background_class %>">

          <!-- Ícone do papel -->
          <div class="text-7xl mb-4"><%= player.role_icon %></div>

          <!-- Nome do papel -->
          <h2 class="font-display text-2xl font-black text-white mb-1">
            <%= player.role_name %>
          </h2>

          <!-- Time -->
          <div class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-bold mb-4 <%= player.team_badge_class %>">
            Time <%= player.team_name %>
          </div>

          <!-- Descrição -->
          <p class="text-center text-sm text-slate-300 mb-4">
            <%= player.role_description %>
          </p>

          <!-- Missão -->
          <div class="bg-black/30 rounded-xl p-3 text-center">
            <p class="text-xs text-slate-300">
              <%= player.team_mission %>
            </p>
          </div>

          <p class="text-slate-500 text-xs mt-4">Toque para esconder</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Habilidades Especiais -->
  <% if player.has_special_ability? && !player.ability_used? %>
    <div class="bg-amber-900/30 border border-amber-500/50 rounded-xl p-4 mb-4">
      <h3 class="text-sm font-semibold text-amber-400 mb-2 uppercase flex items-center gap-2">
        ⚡ Habilidade Especial
      </h3>
      <%= render partial: "games/abilities/#{player.ability_partial}", locals: { game: game, player: player } rescue nil %>
    </div>
  <% end %>

  <!-- Apostador - Fazer palpite -->
  <% if player.role == 'gambler' && player.gambler_guess.blank? %>
    <div class="bg-purple-900/30 border border-purple-500/50 rounded-xl p-4 mb-4">
      <h3 class="text-sm font-semibold text-purple-400 mb-3 uppercase">🎰 Faça seu palpite</h3>
      <p class="text-slate-300 text-sm mb-3">Escolha qual time você acha que vai vencer:</p>
      <%= form_with url: game_ability_path(game, ability: 'gambler_guess'), method: :post, class: "flex gap-2" do %>
        <button type="submit" name="guess" value="blue" class="flex-1 py-3 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-lg transition-all">
          🔵 Azul
        </button>
        <button type="submit" name="guess" value="red" class="flex-1 py-3 bg-red-600 hover:bg-red-500 text-white font-bold rounded-lg transition-all">
          🔴 Vermelho
        </button>
        <button type="submit" name="guess" value="black" class="flex-1 py-3 bg-black hover:bg-black-500 text-white font-bold rounded-lg transition-all">
          ⚫ Preto
        </button>
        <button type="submit" name="guess" value="green" class="flex-1 py-3 bg-green-600 hover:bg-green-500 text-white font-bold rounded-lg transition-all">
          🟢 Verde
        </button>
      <% end %>
    </div>
  <% elsif player.role == 'gambler' && player.gambler_guess.present? %>
    <div class="bg-purple-900/20 border border-purple-500/30 rounded-xl p-4 mb-4 text-center">
      <span class="text-purple-400">🎰 Você apostou no time <%= player.gambler_guess == 'blue' ? '🔵 Azul' : '🔴 Vermelho' %></span>
    </div>
  <% end %>

  <!-- Lista de jogadores na sala com opção de Card Share -->
  <div class="bg-slate-800/30 rounded-xl p-4 mb-4">
    <h3 class="text-sm font-semibold text-slate-400 mb-3 uppercase flex items-center justify-between">
      <span>Jogadores na sua sala</span>
      <%= link_to game_card_shares_path(game), class: "text-amber-400 text-xs hover:text-amber-300" do %>
        📜 Ver histórico
      <% end %>
    </h3>
    <div class="space-y-2">
      <% game.players.where(room: player.room).each do |p| %>
        <div class="flex items-center justify-between bg-slate-700/50 rounded-lg px-3 py-2">
          <span class="<%= p.id == player.id ? 'text-amber-300' : 'text-white' %>">
            <%= p.name %>
            <% if p.id == player.id %>
              <span class="text-xs text-amber-400">(você)</span>
            <% end %>
            <% if p.is_infected? && (player.role == 'zombie' || player.is_infected?) %>
              <span class="text-xs text-green-400">🧟</span>
            <% end %>
          </span>
          
          <% if p.id != player.id %>
            <div class="flex gap-1">
              <%= button_to game_card_shares_path(game), 
                  params: { to_player_id: p.id, share_type: 'card' },
                  method: :post,
                  class: "px-3 py-1 bg-amber-500/20 hover:bg-amber-500/40 text-amber-400 text-xs font-semibold rounded-lg transition-all" do %>
                🎴 Card
              <% end %>
              <%= button_to game_card_shares_path(game), 
                  params: { to_player_id: p.id, share_type: 'color' },
                  method: :post,
                  class: "px-3 py-1 bg-slate-500/20 hover:bg-slate-500/40 text-slate-400 text-xs font-semibold rounded-lg transition-all" do %>
                🎨 Cor
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Solicitações pendentes -->
  <% pending_requests = CardShare.pending.where(game: game, to_player: player) %>
  <% if pending_requests.any? %>
    <div class="bg-amber-900/30 border border-amber-500/50 rounded-xl p-4 mb-20">
      <h3 class="text-sm font-semibold text-amber-400 mb-3 uppercase">📨 Solicitações de Card Share</h3>
      <div class="space-y-2">
        <% pending_requests.includes(:from_player).each do |card_share| %>
          <div class="flex items-center justify-between bg-slate-800/50 rounded-lg p-3">
            <div>
              <span class="text-white font-semibold"><%= card_share.from_player.name %></span>
              <span class="text-slate-400 text-sm ml-2">
                (<%= card_share.share_type == 'card' ? 'Carta completa' : 'Apenas cor' %>)
              </span>
            </div>
            <div class="flex gap-2">
              <%= button_to accept_game_card_share_path(game, card_share), 
                  method: :post,
                  class: "px-3 py-1 bg-green-600 hover:bg-green-500 text-white text-sm font-bold rounded-lg transition-all" do %>
                ✓
              <% end %>
              <%= button_to reject_game_card_share_path(game, card_share), 
                  method: :post,
                  class: "px-3 py-1 bg-red-600/50 hover:bg-red-500 text-white text-sm font-bold rounded-lg transition-all" do %>
                ✗
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="mb-20"></div>
  <% end %>
</div>
