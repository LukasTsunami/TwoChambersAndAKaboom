<script>
  function openRolesModal() {
    document.getElementById('roles-modal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  
  function closeRolesModal() {
    document.getElementById('roles-modal').classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.addEventListener('DOMContentLoaded', function() {
    const modeSelect = document.querySelector('[data-role-selection-target="mode"]');
    const manualSection = document.getElementById('manual-role-selection');
    
    function toggleManualSelection() {
      if (modeSelect.value === 'manual') {
        manualSection.style.display = 'block';
      } else {
        manualSection.style.display = 'none';
      }
    }
    
    modeSelect.addEventListener('change', toggleManualSelection);
    toggleManualSelection();
    
    // Fechar modal com ESC
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeRolesModal();
      }
    });
  });
</script>
