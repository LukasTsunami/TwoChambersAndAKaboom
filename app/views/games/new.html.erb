<div class="flex-1 flex flex-col items-center justify-center px-6 py-12 pb-24">
  <!-- Header -->
  <div class="text-center mb-8">
    <div class="text-5xl mb-4">🏠</div>
    <h1 class="font-display text-2xl font-bold text-white mb-2">Criar Nova Sala</h1>
    <p class="text-slate-400">Configure as opções do jogo</p>
  </div>

  <!-- Formulário -->
  <div class="w-full max-w-sm">
    <%= form_with model: @game, url: games_path, method: :post, class: "space-y-6", data: { controller: "role-selection" } do |f| %>
      <div>
        <label class="block text-slate-300 text-sm font-semibold mb-2 uppercase tracking-wide">
          ⏱️ Tempo por Rodada
        </label>
        <select name="game[round_time]" class="w-full px-5 py-4 bg-slate-800/50 border-2 border-slate-600 rounded-xl text-white text-lg font-semibold focus:outline-none focus:border-amber-400 transition-all">
          <option value="60">1 minuto</option>
          <option value="120">2 minutos</option>
          <option value="180" selected>3 minutos</option>
          <option value="240">4 minutos</option>
          <option value="300">5 minutos</option>
        </select>
      </div>

      <div>
        <label class="block text-slate-300 text-sm font-semibold mb-2 uppercase tracking-wide">
          🔄 Número de Rodadas
        </label>
        <select name="game[total_rounds]" class="w-full px-5 py-4 bg-slate-800/50 border-2 border-slate-600 rounded-xl text-white text-lg font-semibold focus:outline-none focus:border-amber-400 transition-all">
          <option value="0">Automático (baseado em jogadores)</option>
          <option value="1">1 rodada</option>
          <option value="2">2 rodadas</option>
          <option value="3" selected>3 rodadas</option>
          <option value="4">4 rodadas</option>
          <option value="5">5 rodadas</option>
        </select>
        <p class="text-slate-500 text-sm mt-2">
          💡 Automático segue as regras oficiais baseadas na quantidade de jogadores
        </p>
      </div>

      <!-- Modo de Seleção de Roles -->
      <div>
        <label class="block text-slate-300 text-sm font-semibold mb-2 uppercase tracking-wide">
          🎭 Papéis Especiais
        </label>
        <select name="game[role_selection_mode]" 
                class="w-full px-5 py-4 bg-slate-800/50 border-2 border-slate-600 rounded-xl text-white text-lg font-semibold focus:outline-none focus:border-amber-400 transition-all"
                data-role-selection-target="modeSelect"
                data-action="change->role-selection#toggleManualSelection"
          >
          <option value="manual">Selecionar manualmente</option>
          <option value="all">Usar todos os papéis</option>
          <option value="by_players">Baseado no número de jogadores</option>
          <option value="random">Aleatório</option>
        </select>
      </div>

      <!-- Seleção Manual de Roles -->  
      <div id="manual-role-selection" class="hidden" data-role-selection-target="manualSection">
        <!-- Roles Especiais Azul -->
        <div class="mb-4">
          <h3 class="text-blue-400 text-sm font-semibold mb-2 flex items-center gap-2">
            🔵 Especiais Azul
          </h3>
          <div class="grid grid-cols-2 gap-2">
            <label class="flex items-center gap-2 bg-blue-900/20 border border-blue-500/30 rounded-lg p-2 cursor-pointer hover:bg-blue-900/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="doctor" class="accent-blue-500">
              <span class="text-sm text-white">⚕️ Médico</span>
            </label>
            <label class="flex items-center gap-2 bg-blue-900/20 border border-blue-500/30 rounded-lg p-2 cursor-pointer hover:bg-blue-900/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="agent" class="accent-blue-500">
              <span class="text-sm text-white">🕵️ Agente</span>
            </label>
            <label class="flex items-center gap-2 bg-blue-900/20 border border-blue-500/30 rounded-lg p-2 cursor-pointer hover:bg-blue-900/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="soldier" class="accent-blue-500">
              <span class="text-sm text-white">🎖️ Soldado</span>
            </label>
          </div>
        </div>

        <!-- Roles Especiais Vermelho -->
        <div class="mb-4">
          <h3 class="text-red-400 text-sm font-semibold mb-2 flex items-center gap-2">
            🔴 Especiais Vermelho
          </h3>
          <div class="grid grid-cols-2 gap-2">
            <label class="flex items-center gap-2 bg-red-900/20 border border-red-500/30 rounded-lg p-2 cursor-pointer hover:bg-red-900/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="dr_boom" class="accent-red-500">
              <span class="text-sm text-white">🧨 Dr. Boom</span>
            </label>
            <label class="flex items-center gap-2 bg-red-900/20 border border-red-500/30 rounded-lg p-2 cursor-pointer hover:bg-red-900/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="engineer" class="accent-red-500">
              <span class="text-sm text-white">🔧 Engenheiro</span>
            </label>
            <label class="flex items-center gap-2 bg-red-900/20 border border-red-500/30 rounded-lg p-2 cursor-pointer hover:bg-red-900/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="fanatic" class="accent-red-500">
              <span class="text-sm text-white">⛪ Fanático</span>
            </label>
          </div>
        </div>

        <!-- Roles Genéricos -->
        <div class="mb-4">
          <h3 class="text-purple-400 text-sm font-semibold mb-2 flex items-center gap-2">
            ⚔️ Genéricos (Azul e Vermelho)
          </h3>
          <div class="grid grid-cols-2 gap-2">
            <label class="flex items-center gap-2 bg-purple-900/20 border border-purple-500/30 rounded-lg p-2 cursor-pointer hover:bg-purple-900/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="spy" class="accent-purple-500">
              <span class="text-sm text-white">🕵️ Espião</span>
            </label>
            <label class="flex items-center gap-2 bg-purple-900/20 border border-purple-500/30 rounded-lg p-2 cursor-pointer hover:bg-purple-900/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="mime" class="accent-purple-500">
              <span class="text-sm text-white">🤐 Mímico</span>
            </label>
            <label class="flex items-center gap-2 bg-purple-900/20 border border-purple-500/30 rounded-lg p-2 cursor-pointer hover:bg-purple-900/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="usurper" class="accent-purple-500">
              <span class="text-sm text-white">👑 Usurpadora</span>
            </label>
            <label class="flex items-center gap-2 bg-purple-900/20 border border-purple-500/30 rounded-lg p-2 cursor-pointer hover:bg-purple-900/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="kangaroo" class="accent-purple-500">
              <span class="text-sm text-white">🦘 Canguru</span>
            </label>
            <label class="flex items-center gap-2 bg-purple-900/20 border border-purple-500/30 rounded-lg p-2 cursor-pointer hover:bg-purple-900/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="gargoyle" class="accent-purple-500">
              <span class="text-sm text-white">🗿 Gárgula</span>
            </label>
            <label class="flex items-center gap-2 bg-purple-900/20 border border-purple-500/30 rounded-lg p-2 cursor-pointer hover:bg-purple-900/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="pirate" class="accent-purple-500">
              <span class="text-sm text-white">🏴‍☠️ Pirata</span>
            </label>
            <label class="flex items-center gap-2 bg-purple-900/20 border border-purple-500/30 rounded-lg p-2 cursor-pointer hover:bg-purple-900/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="enlisted" class="accent-purple-500">
              <span class="text-sm text-white">🙋 Alistado</span>
            </label>
          </div>
        </div>

        <!-- Roles de Jogador Ímpar -->
        <div class="mb-4">
          <h3 class="text-slate-400 text-sm font-semibold mb-2 flex items-center gap-2">
            ⚫🟢 Jogador Ímpar (quando número de jogadores é ímpar)
          </h3>
          <div class="grid grid-cols-2 gap-2">
            <label class="flex items-center gap-2 bg-slate-800/40 border border-slate-500/30 rounded-lg p-2 cursor-pointer hover:bg-slate-700/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="hot_potato" class="accent-slate-500">
              <span class="text-sm text-white">🥔 Batata Quente</span>
            </label>
            <label class="flex items-center gap-2 bg-slate-800/40 border border-slate-500/30 rounded-lg p-2 cursor-pointer hover:bg-slate-700/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="gambler" class="accent-slate-500">
              <span class="text-sm text-white">🎰 Apostador</span>
            </label>
            <label class="flex items-center gap-2 bg-slate-800/40 border border-slate-500/30 rounded-lg p-2 cursor-pointer hover:bg-slate-700/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="evil_genius" class="accent-slate-500">
              <span class="text-sm text-white">🧠 Gênio do Mal</span>
            </label>
            <label class="flex items-center gap-2 bg-slate-800/40 border border-slate-500/30 rounded-lg p-2 cursor-pointer hover:bg-slate-700/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="stepfather" class="accent-slate-500">
              <span class="text-sm text-white">👨‍👧‍👦 Padrasto</span>
            </label>
            <label class="flex items-center gap-2 bg-green-900/20 border border-green-500/30 rounded-lg p-2 cursor-pointer hover:bg-green-900/40 transition-all">
              <input type="checkbox" name="game[selected_roles][]" value="zombie" class="accent-green-500">
              <span class="text-sm text-white">🧟 Zumbi</span>
            </label>
          </div>
        </div>
      </div>

      <div class="pt-4 space-y-3">
        <button type="submit" class="w-full py-4 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-900 font-bold text-lg rounded-xl transition-all transform hover:scale-105 active:scale-95 shadow-lg">
          🚀 Criar Sala
        </button>

        <%= link_to root_path, class: "block w-full py-3 text-center text-slate-400 hover:text-white transition-colors" do %>
          ← Voltar
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- Botão Flutuante -->
<button 
  type="button"
  data-controller="modal"
  data-action="click->modal#open"
  data-modal-id="roles-modal"
  class="fixed bottom-6 right-6 z-40 flex items-center gap-2 px-5 py-3 text-white font-bold rounded-full shadow-2xl transition-all transform hover:scale-105 active:scale-95 border border-purple-500/50 hover:border-purple-400"
  style="background: rgba(15, 23, 42, 0.15); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);"
>
  <span class="text-xl">📖</span>
  <span>Consultar Papéis</span>
</button>

<%= render 'shared/roles_modal' %>
