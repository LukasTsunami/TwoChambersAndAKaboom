<div class="flex-1 flex flex-col items-center justify-center px-6 py-12">
  <!-- Header -->
  <div class="text-center mb-8">
    <div class="text-5xl mb-4">🚪</div>
    <h1 class="font-display text-2xl font-bold text-white mb-2">Entrar numa Sala</h1>
    <p class="text-slate-400">Digite o código da sala</p>
  </div>

  <!-- Formulário -->
  <div class="w-full max-w-sm">
    <%= form_with url: enter_games_path, method: :post, class: "space-y-6" do |f| %>
      <div>
        <label class="block text-slate-300 text-sm font-semibold mb-2 uppercase tracking-wide">
          Código da Sala
        </label>
        <input
          type="text"
          name="code"
          required
          autofocus
          autocomplete="off"
          placeholder="Ex: ABC123"
          maxlength="6"
          class="w-full px-5 py-4 bg-slate-800/50 border-2 border-slate-600 rounded-xl text-white text-2xl font-bold text-center tracking-[0.3em] uppercase placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 transition-all"
        >
      </div>

      <div class="pt-4 space-y-3">
        <button type="submit" class="w-full py-4 bg-gradient-to-r from-blue-500 to-cyan-500 hover:from-blue-400 hover:to-cyan-400 text-white font-bold text-lg rounded-xl transition-all transform hover:scale-105 active:scale-95 shadow-lg">
          🚪 Entrar na Sala
        </button>

        <%= link_to root_path, class: "block w-full py-3 text-center text-slate-400 hover:text-white transition-colors" do %>
          ← Voltar
        <% end %>
      </div>
    <% end %>
  </div>
</div>

