<div class="flex-1 flex flex-col items-center justify-center px-6 py-12">
  <!-- Header -->
  <div class="text-center mb-8">
    <div class="text-5xl mb-4">🏠</div>
    <h1 class="font-display text-2xl font-bold text-white mb-2">Apagar Sala</h1>
    <p class="text-slate-400">Apagar uma sala de jogo e remover todos os jogadores</p>
  </div>

  <!-- Formulário -->
  <div class="w-full max-w-sm">
    <%= form_with url: admin_reset_room_path, method: :post, class: "space-y-6" do |f| %>
      <div>
        <label class="block text-slate-300 text-sm font-semibold mb-2 uppercase tracking-wide">
          Código da Sala
        </label>
        <input
          type="text"
          name="code"
          required
          autofocus
          autocomplete="off"
          placeholder="Ex: ABC123"
          list="rooms-list"
          class="w-full px-5 py-4 bg-slate-800/50 border-2 border-slate-600 rounded-xl text-white text-lg font-semibold placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 transition-all text-center font-mono uppercase tracking-widest"
        >
        <datalist id="rooms-list">
          <% @games.each do |game| %>
            <option value="<%= game.code %>">
          <% end %>
        </datalist>
      </div>

      <button type="submit" class="w-full py-4 bg-gradient-to-r from-red-500 to-pink-500 hover:from-red-400 hover:to-pink-400 text-white font-bold text-lg rounded-xl transition-all transform hover:scale-105 active:scale-95 shadow-lg">
        🗑️ Apagar Sala
      </button>
    <% end %>

    <div class="flex gap-2 mt-4">
      <%= link_to admin_reset_pin_path, class: "flex-1 py-3 text-center text-slate-400 hover:text-white transition-colors bg-slate-800/30 rounded-xl" do %>
        🔑 Reset PIN
      <% end %>
      <%= link_to admin_reset_player_path, class: "flex-1 py-3 text-center text-slate-400 hover:text-white transition-colors bg-slate-800/30 rounded-xl" do %>
        👤 Apagar Jogador
      <% end %>
    </div>

    <%= link_to root_path, class: "block w-full py-3 text-center text-slate-400 hover:text-white transition-colors mt-4" do %>
      ← Voltar ao Início
    <% end %>
  </div>

  <!-- Lista de salas -->
  <% if @games.any? %>
    <div class="w-full max-w-sm mt-8">
      <h3 class="text-sm font-semibold text-slate-400 mb-3 uppercase">Salas Ativas (<%= @games.count %>)</h3>
      <div class="bg-slate-800/30 rounded-xl p-4 max-h-64 overflow-y-auto">
        <div class="space-y-3">
          <% @games.each do |game| %>
            <div class="flex items-center justify-between bg-slate-700/30 rounded-lg p-3">
              <div>
                <p class="text-white font-mono font-bold"><%= game.code %></p>
                <p class="text-slate-400 text-xs"><%= game.players.count %> jogadores</p>
              </div>
              <div class="text-right">
                <span class="px-2 py-1 rounded-full text-xs font-semibold
                  <% case game.status %>
                  <% when 'waiting' %>
                    bg-yellow-500/20 text-yellow-400
                  <% when 'playing' %>
                    bg-green-500/20 text-green-400
                  <% when 'leader_selection' %>
                    bg-amber-500/20 text-amber-400
                  <% when 'hostage_exchange' %>
                    bg-purple-500/20 text-purple-400
                  <% when 'finished' %>
                    bg-slate-500/20 text-slate-400
                  <% end %>
                ">
                  <%= game.status.humanize %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="w-full max-w-sm mt-8 text-center">
      <p class="text-slate-500">Nenhuma sala ativa no momento.</p>
    </div>
  <% end %>
</div>

