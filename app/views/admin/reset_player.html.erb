<div class="flex-1 flex flex-col items-center justify-center px-6 py-12">
  <!-- Header -->
  <div class="text-center mb-8">
    <div class="text-5xl mb-4">👤</div>
    <h1 class="font-display text-2xl font-bold text-white mb-2">Apagar Jogador</h1>
    <p class="text-slate-400">Apagar um jogador do sistema permanentemente</p>
  </div>

  <!-- Formulário -->
  <div class="w-full max-w-sm">
    <%= form_with url: admin_reset_player_path, method: :post, class: "space-y-6" do |f| %>
      <div>
        <label class="block text-slate-300 text-sm font-semibold mb-2 uppercase tracking-wide">
          Nome do Jogador
        </label>
        <input
          type="text"
          name="name"
          required
          autofocus
          autocomplete="off"
          placeholder="Digite o nome exato..."
          list="players-list"
          class="w-full px-5 py-4 bg-slate-800/50 border-2 border-slate-600 rounded-xl text-white text-lg font-semibold placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 transition-all"
        >
        <datalist id="players-list">
          <% @players.each do |player| %>
            <option value="<%= player.name %>">
          <% end %>
        </datalist>
      </div>

      <div class="bg-red-500/10 border border-red-500/30 rounded-xl p-4">
        <p class="text-red-400 text-sm text-center">
          ⚠️ <strong>Atenção:</strong> Esta ação é irreversível!
        </p>
      </div>

      <button type="submit" class="w-full py-4 bg-gradient-to-r from-red-500 to-pink-500 hover:from-red-400 hover:to-pink-400 text-white font-bold text-lg rounded-xl transition-all transform hover:scale-105 active:scale-95 shadow-lg">
        🗑️ Apagar Jogador
      </button>
    <% end %>

    <div class="flex gap-2 mt-4">
      <%= link_to admin_reset_pin_path, class: "flex-1 py-3 text-center text-slate-400 hover:text-white transition-colors bg-slate-800/30 rounded-xl" do %>
        🔑 Reset PIN
      <% end %>
      <%= link_to admin_reset_room_path, class: "flex-1 py-3 text-center text-slate-400 hover:text-white transition-colors bg-slate-800/30 rounded-xl" do %>
        🏠 Apagar Sala
      <% end %>
    </div>

    <%= link_to root_path, class: "block w-full py-3 text-center text-slate-400 hover:text-white transition-colors mt-4" do %>
      ← Voltar ao Início
    <% end %>
  </div>

  <!-- Lista de jogadores -->
  <% if @players.any? %>
    <div class="w-full max-w-sm mt-8">
      <h3 class="text-sm font-semibold text-slate-400 mb-3 uppercase">Jogadores Cadastrados (<%= @players.count %>)</h3>
      <div class="bg-slate-800/30 rounded-xl p-4 max-h-64 overflow-y-auto">
        <div class="space-y-2">
          <% @players.each do |player| %>
            <div class="flex items-center justify-between text-sm bg-slate-700/30 rounded-lg p-2">
              <span class="text-white font-semibold"><%= player.name %></span>
              <span class="text-slate-500 text-xs">
                <% if player.game %>
                  <span class="text-green-400">🎮 <%= player.game.code %></span>
                <% else %>
                  Sem jogo
                <% end %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="w-full max-w-sm mt-8 text-center">
      <p class="text-slate-500">Nenhum jogador cadastrado.</p>
    </div>
  <% end %>
</div>

