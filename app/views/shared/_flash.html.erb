<% case type.to_s %>
<% when 'notice' %>
  <div class="bg-green-500/20 border border-green-500/50 text-green-300 rounded-xl p-4 mb-4">
    <%= message %>
  </div>
<% when 'alert' %>
  <div class="bg-red-500/20 border border-red-500/50 text-red-300 rounded-xl p-4 mb-4">
    <%= message %>
  </div>
<% end %>

