<div class="min-h-screen bg-gradient-to-br from-slate-900 to-slate-800 py-8 px-4">
  <div class="max-w-lg mx-auto">
    <div class="flex items-center gap-3 mb-6">
      <%= link_to @game, class: "text-slate-400 hover:text-white transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      <% end %>
      <h1 class="font-display text-2xl font-bold text-white">Card Share</h1>
    </div>

    <% if @pending_requests.any? %>
      <div class="mb-6">
        <h2 class="text-sm font-semibold text-amber-400 mb-3 uppercase">Solicitações Recebidas</h2>
        <div class="space-y-3">
          <% @pending_requests.each do |card_share| %>
            <div class="bg-slate-800/50 rounded-xl p-4 border border-amber-500/30">
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                  <span class="text-xl">🎴</span>
                  <span class="font-semibold text-white"><%= card_share.from_player.name %></span>
                </div>
                <span class="text-xs text-slate-400">
                  <%= card_share.share_type == 'card' ? 'Carta completa' : 'Apenas cor' %>
                </span>
              </div>
              
              <div class="flex gap-2">
                <%= button_to "Aceitar", 
                    accept_game_card_share_path(@game, card_share), 
                    method: :post,
                    class: "flex-1 py-2 bg-green-600 hover:bg-green-500 text-white font-bold rounded-lg transition-all" %>
                
                <%= button_to "Recusar", 
                    reject_game_card_share_path(@game, card_share), 
                    method: :post,
                    class: "flex-1 py-2 bg-red-600/50 hover:bg-red-500 text-white font-bold rounded-lg transition-all" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @my_requests.any? %>
      <div class="mb-6">
        <h2 class="text-sm font-semibold text-blue-400 mb-3 uppercase">Solicitações Enviadas</h2>
        <div class="space-y-2">
          <% @my_requests.each do |card_share| %>
            <div class="bg-slate-800/30 rounded-xl p-3 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span>→</span>
                <span class="text-white"><%= card_share.to_player.name %></span>
              </div>
              <span class="text-xs text-amber-400 animate-pulse">Aguardando...</span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @history.any? %>
      <div class="mb-6">
        <h2 class="text-sm font-semibold text-slate-400 mb-3 uppercase">Histórico</h2>
        <div class="space-y-2">
          <% @history.each do |card_share| %>
            <div class="bg-slate-800/20 rounded-xl p-3 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="text-green-400">✓</span>
                <span class="text-slate-300">
                  <% if card_share.from_player == current_player %>
                    Você → <%= card_share.to_player.name %>
                  <% else %>
                    <%= card_share.from_player.name %> → Você
                  <% end %>
                </span>
              </div>
              <span class="text-xs text-slate-500">Rodada <%= card_share.round %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="bg-slate-800/30 rounded-xl p-4 text-center text-slate-400">
      <p class="text-sm">Para compartilhar sua carta, toque no nome de um jogador na sua sala.</p>
    </div>
  </div>
</div>

