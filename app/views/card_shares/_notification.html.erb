<div class="fixed top-4 right-4 z-50 animate-pulse" id="card_share_<%= card_share.id %>">
  <div class="bg-amber-500/90 backdrop-blur-sm rounded-xl p-4 shadow-2xl max-w-sm">
    <div class="flex items-center gap-3 mb-3">
      <span class="text-2xl">🎴</span>
      <div>
        <p class="font-bold text-slate-900">Solicitação de Card Share</p>
        <p class="text-sm text-slate-800"><%= card_share.from_player.name %> quer compartilhar a carta</p>
      </div>
    </div>
    
    <div class="flex gap-2">
      <%= button_to "✓ Aceitar", 
          accept_game_card_share_path(card_share.game, card_share), 
          method: :post,
          class: "flex-1 py-2 bg-green-600 hover:bg-green-500 text-white font-bold rounded-lg transition-all" %>
      
      <%= button_to "✗ Recusar", 
          reject_game_card_share_path(card_share.game, card_share), 
          method: :post,
          class: "flex-1 py-2 bg-red-600 hover:bg-red-500 text-white font-bold rounded-lg transition-all" %>
    </div>
  </div>
</div>

