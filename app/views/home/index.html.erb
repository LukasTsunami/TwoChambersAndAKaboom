<div class="flex-1 flex flex-col items-center justify-center px-6 py-12" data-controller="modal">
  <!-- Logo / Título -->
  <div class="text-center mb-12">
    <div class="text-6xl mb-4">💣</div>
    <h1 class="font-display text-3xl font-black tracking-wider text-white mb-2">
      TWO ROOMS
    </h1>
    <h2 class="font-display text-2xl font-bold text-amber-400">
      AND A BOOM
    </h2>
    <p class="text-slate-400 mt-4 text-lg">
      O jogo de dedução social definitivo
    </p>
  </div>

  <!-- Formulário -->
  <div class="w-full max-w-sm">
    <%= form_with url: players_path, method: :post, class: "space-y-6" do |f| %>
      <div>
        <label class="block text-slate-300 text-sm font-semibold mb-2 uppercase tracking-wide">
          Seu Nome
        </label>
        <input
          type="text"
          name="name"
          required
          autofocus
          autocomplete="off"
          placeholder="Digite seu nome..."
          class="w-full px-5 py-4 bg-slate-800/50 border-2 border-slate-600 rounded-xl text-white text-lg font-semibold placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-400/20 transition-all"
        >
      </div>

      <div class="grid grid-cols-2 gap-4">
        <button
          type="submit"
          name="action_type"
          value="create"
          class="py-4 px-6 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-900 font-bold text-lg rounded-xl transition-all transform hover:scale-105 active:scale-95 shadow-lg"
        >
          🏠 Criar Sala
        </button>

        <button
          type="submit"
          name="action_type"
          value="join"
          class="py-4 px-6 bg-gradient-to-r from-blue-500 to-cyan-500 hover:from-blue-400 hover:to-cyan-400 text-white font-bold text-lg rounded-xl transition-all transform hover:scale-105 active:scale-95 shadow-lg"
        >
          🚪 Entrar
        </button>
      </div>
    <% end %>
  </div>

  <!-- Botões de informação -->
  <div class="fixed bottom-6 left-6 right-6 flex justify-between">
    <button
      type="button"
      data-action="click->modal#open"
      data-modal-id="rules-modal"
      class="px-4 py-2 bg-slate-700/50 backdrop-blur-sm rounded-full text-slate-300 text-sm font-semibold hover:bg-slate-600/50 transition-all flex items-center gap-2"
    >
      📖 Regras
    </button>

    <button
      type="button"
      data-action="click->modal#open"
      data-modal-id="characters-modal"
      class="px-4 py-2 bg-slate-700/50 backdrop-blur-sm rounded-full text-slate-300 text-sm font-semibold hover:bg-slate-600/50 transition-all flex items-center gap-2"
    >
      🎭 Personagens
    </button>
  </div>
</div>

<%= render 'shared/rules_modal' %>
<%= render 'shared/characters_modal' %>
